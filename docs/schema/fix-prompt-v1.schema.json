{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alainrk/paranoid/docs/schema/fix-prompt-v1.schema.json",
  "title": "paranoid fix-prompt report, schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instructions", "notes"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "instructions": {
      "type": "array",
      "items": { "$ref": "#/$defs/instruction" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "file", "line", "instruction"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}[0-9]{3}$"
        },
        "severity": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "instruction": {
          "type": "string"
        }
      }
    }
  }
}
