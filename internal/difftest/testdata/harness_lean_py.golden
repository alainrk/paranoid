-- Generated by paranoid for the differential test. Do not edit.
import Lean
import Formal.Paranoid.MF

open Lean

namespace ParanoidDiff

def decArray {α : Type} (d : Json → Except String α) (j : Json) : Except String (Array α) := do
  let xs ← j.getArr?
  xs.mapM d

def decBool (j : Json) : Except String Bool := j.getBool?

def decInt (j : Json) : Except String Int := j.getInt?

def decString (j : Json) : Except String String := j.getStr?

def encArray {α : Type} (e : α → Json) (xs : Array α) : Json := Json.arr (xs.map e)

def encBool (x : Bool) : Json := toJson x

def encInt (x : Int) : Json := toJson x

def encString (x : String) : Json := toJson x

def step (line : String) : Except String Json := do
  let j ← Json.parse line
  let args ← j.getArr?
  if args.size != 2 then throw s!"expected 2 arguments, got {args.size}"
  let a0 ← decInt args[0]!
  let a1 ← (decArray (decArray decBool)) args[1]!
  pure (encString (Paranoid.MF.model a0 a1))

def runLine (line : String) : String :=
  match step line with
  | .ok v => (Json.mkObj [("ok", v)]).compress
  | .error e => (Json.mkObj [("error", Json.str e)]).compress

end ParanoidDiff

def main (args : List String) : IO UInt32 := do
  match args with
  | [inPath, outPath] =>
    let content ← IO.FS.readFile inPath
    let mut out := ""
    for line in content.splitOn "\n" do
      if line.trim.isEmpty then continue
      out := out ++ ParanoidDiff.runLine line ++ "\n"
    IO.FS.writeFile outPath out
    return 0
  | _ =>
    IO.eprintln "usage: harness <input> <output>"
    return 1
