-- Generated by paranoid for the differential test. Do not edit.
import Lean
import Formal.Paranoid.DemoSum

open Lean

namespace ParanoidDiff

def decArray {α : Type} (d : Json → Except String α) (j : Json) : Except String (Array α) := do
  let xs ← j.getArr?
  xs.mapM d

def decBool (j : Json) : Except String Bool := j.getBool?

def decInt32 (j : Json) : Except String Int32 := do
  let i ← j.getInt?
  if (Int32.ofInt i).toInt == i then pure (Int32.ofInt i) else throw s!"integer {i} is out of range for Int32"

def decString (j : Json) : Except String String := j.getStr?

def decUInt8 (j : Json) : Except String UInt8 := do
  let i ← j.getInt?
  if i < 0 then throw s!"integer {i} is out of range for UInt8"
  let n := i.toNat
  if (UInt8.ofNat n).toNat == n then pure (UInt8.ofNat n) else throw s!"integer {i} is out of range for UInt8"

def encArray {α : Type} (e : α → Json) (xs : Array α) : Json := Json.arr (xs.map e)

def encBool (x : Bool) : Json := toJson x

def encInt32 (x : Int32) : Json := toJson x.toInt

def encString (x : String) : Json := toJson x

def encUInt8 (x : UInt8) : Json := toJson x.toNat

def step (line : String) : Except String Json := do
  let j ← Json.parse line
  let args ← j.getArr?
  if args.size != 4 then throw s!"expected 4 arguments, got {args.size}"
  let a0 ← (decArray decInt32) args[0]!
  let a1 ← decUInt8 args[1]!
  let a2 ← decString args[2]!
  let a3 ← decBool args[3]!
  pure ((encArray encString) (Paranoid.DemoSum.model a0 a1 a2 a3))

def runLine (line : String) : String :=
  match step line with
  | .ok v => (Json.mkObj [("ok", v)]).compress
  | .error e => (Json.mkObj [("error", Json.str e)]).compress

end ParanoidDiff

def main (args : List String) : IO UInt32 := do
  match args with
  | [inPath, outPath] =>
    let content ← IO.FS.readFile inPath
    let mut out := ""
    for line in content.splitOn "\n" do
      if line.trim.isEmpty then continue
      out := out ++ ParanoidDiff.runLine line ++ "\n"
    IO.FS.writeFile outPath out
    return 0
  | _ =>
    IO.eprintln "usage: harness <input> <output>"
    return 1
